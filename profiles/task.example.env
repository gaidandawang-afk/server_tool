# Copy to profiles/<profile>.local.env. Local profiles are ignored by Git.
PROFILE_NAME=example-task

REMOTE_HOST=123.60.231.86
REMOTE_PORT=6200
REMOTE_USER=root
SSH_KEY=C:\Users\you\.ssh\server_tool_ed25519
# Optional. Without this, Paramiko uses the system known_hosts and warns for an unknown host.
KNOWN_HOSTS=C:\Users\you\.ssh\known_hosts

CONTAINER_NAME=sglang-ssh-v0.5.16
CONTAINER_MANIFEST=/data2/iws/container-manifests/sglang-ssh-v0.5.16.env

LOCAL_REPO=D:\path\to\source
LOCAL_BRANCH=feature-branch
REMOTE_BRANCH=feature-branch

REMOTE_TASK_ROOT=/data2/iws/tasks/example-task
REMOTE_PROJECT_ROOT=/data2/iws/projects/example-task
LOCAL_ARTIFACT_ROOT=D:\Codex\tools\server_tool\work\example-task\artifacts

GPU_IDS=all
PORT_BASE=6100
PORT_COUNT=10

MODEL_PATH=/data1/models/Qwen3-30B-A3B-FP8
# Install each ABI-sensitive version once into a distinct immutable directory.
SGLANG_KERNEL_ROOT=/data2/iws/deps/sglang-kernel/cu130-cp312/0.4.2.post1
SGLANG_KERNEL_VERSION=0.4.2.post1
MOONCAKE_ROOT=/data2/iws/deps/mooncake/cu130-cp312/0.3.11.post1
MOONCAKE_VERSION=0.3.11.post1
MOONCAKE_WHEEL=/data2/iws/builds/mooncake/example.whl
MOONCAKE_SOURCE_COMMIT=0123456789abcdef0123456789abcdef01234567
MOONCAKE_WHEEL_SHA256=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
